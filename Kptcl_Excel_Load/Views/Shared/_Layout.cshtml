<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KPTCL Work Details</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <div class="app-container">

        <!-- =========================
             SIDEBAR
             ========================= -->

        <aside class="sidebar">

            <div class="sidebar-brand">

                <div class="brand-icon">
                    ▤
                </div>

                <div class="brand-text">

                    <strong>Work Details</strong>
                    <span>Management</span>

                </div>

            </div>


            <nav class="sidebar-nav">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-item active">

                    <span class="nav-icon">⌂</span>

                    <span>Dashboard</span>

                </a>


                <a href="#upload"
                   class="nav-item">

                    <span class="nav-icon">↑</span>

                    <span>Upload Excel</span>

                </a>


                <a href="#work-orders"
                   class="nav-item">

                    <span class="nav-icon">▣</span>

                    <span>Work Details</span>

                </a>


                <a href="#stations"
                   class="nav-item">

                    <span class="nav-icon">▦</span>

                    <span>Station Details</span>

                </a>


                <a href="#lines"
                   class="nav-item">

                    <span class="nav-icon">◇</span>

                    <span>Line Code Details</span>

                </a>


                <a href="/swagger"
                   target="_blank"
                   class="nav-item">

                    <span class="nav-icon">◇</span>

                    <span>API / Swagger</span>

                </a>


                <a href="#history"
                   class="nav-item">

                    <span class="nav-icon">◷</span>

                    <span>Upload History</span>

                </a>


                

            </nav>


            <div class="sidebar-footer">

                <div class="database-status"
                     id="databaseStatus">

                    <span class="online-dot"
                          id="databaseStatusDot"></span>

                    <div>

                        <strong>Oracle Database</strong>

                        <small id="databaseStatusText">
                            Checking...
                        </small>

                    </div>

                </div>

            </div>

        </aside>


        <!-- =========================
             MAIN CONTENT
             ========================= -->

        <div class="main-container">


            <!-- TOP BAR -->

            <header class="topbar">

                <div>

                    <span class="breadcrumb">
                        KPTCL
                    </span>

                    <span class="breadcrumb-separator">
                        /
                    </span>

                    <span class="breadcrumb-current">
                        Dashboard
                    </span>

                </div>


                <div class="topbar-right">

                    <div class="notification">
                        ♧
                        <span class="notification-dot"></span>
                    </div>


                    <div class="user-info">

                        <div class="user-avatar">
                            A
                        </div>

                        <div>

                            <strong>Admin</strong>

                            <small>
                                Administrator
                            </small>

                        </div>

                        <span class="dropdown-arrow">
                            ▼
                        </span>

                    </div>

                </div>

            </header>


            <!-- PAGE -->

            <main class="main-content">

                @RenderBody()

            </main>


        </div>

    </div>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

    <script>

            // =====================================================
            // ORACLE DATABASE STATUS
            // =====================================================

            async function checkDatabaseStatus() {

                const statusText =
                    document.getElementById("databaseStatusText");

                const statusDot =
                    document.getElementById("databaseStatusDot");


                if (!statusText || !statusDot) {
                    return;
                }


                // ---------------------------------------------
                // Checking
                // ---------------------------------------------

                statusText.innerText =
                    "Checking...";

                statusDot.classList.remove(
                    "database-online",
                    "database-offline"
                );

                statusDot.classList.add(
                    "database-checking"
                );


                try {

                    const response =
                        await fetch(
                            "/api/DatabaseHealth",
                            {
                                method: "GET",
                                headers: {
                                    "Accept": "application/json"
                                },
                                cache: "no-store"
                            }
                        );


                    let result = null;


                    try {

                        result =
                            await response.json();

                    }
                    catch {

                        result = null;

                    }


                    // -----------------------------------------
                    // Connected
                    // -----------------------------------------

                    if (
                        response.ok &&
                        result &&
                        result.connected === true
                    ) {

                        statusText.innerText =
                            "Connected";

                        statusDot.classList.remove(
                            "database-checking",
                            "database-offline"
                        );

                        statusDot.classList.add(
                            "database-online"
                        );

                        return;
                    }


                    // -----------------------------------------
                    // Disconnected
                    // -----------------------------------------

                    statusText.innerText =
                        "Disconnected";

                    statusDot.classList.remove(
                        "database-checking",
                        "database-online"
                    );

                    statusDot.classList.add(
                        "database-offline"
                    );

                }
                catch (error) {

                    console.error(
                        "Database health check failed:",
                        error
                    );


                    statusText.innerText =
                        "Disconnected";


                    statusDot.classList.remove(
                        "database-checking",
                        "database-online"
                    );

                    statusDot.classList.add(
                        "database-offline"
                    );

                }

            }


            // =====================================================
            // INITIAL CHECK
            // =====================================================

            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    checkDatabaseStatus();

                }
            );


            // =====================================================
            // CHECK EVERY 30 SECONDS
            // =====================================================

            setInterval(
                checkDatabaseStatus,
                30000
            );

    </script>

</body>

</html>