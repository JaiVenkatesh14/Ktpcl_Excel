@{
    ViewData["Title"] = "Dashboard";
}


<!-- =========================
     PAGE HEADER
     ========================= -->

<div class="page-heading">

    <div>

        <h1>Dashboard</h1>

        <p>
            Welcome back, Admin
        </p>

    </div>

    <div class="system-status">

        <span class="status-dot"></span>

        System Online

    </div>

</div>







<!-- =========================
     STATISTICS
     ========================= -->

<div class="stats-grid">


    <div class="stat-card">

        <div class="stat-icon blue">
            ▣
        </div>

        <div class="stat-content">

            <span>Total Work Orders</span>

            <strong id="workOrderCount">0</strong>

            <small>
                WORK_ORDER
            </small>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon green">
            ▦
        </div>

        <div class="stat-content">

            <span>Total Stations</span>

            <strong id="stationCount">0</strong>

            <small>
                STATION_DETAILS
            </small>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon orange">
            ◇
        </div>

        <div class="stat-content">

            <span>Total Lines</span>

            <strong id="lineCount">0</strong>

            <small>
                LINE_CODE_DETAILS
            </small>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon purple">
            ↑
        </div>

        <div class="stat-content">

            <span>Total Imports</span>

            <strong>0</strong>

            <small>
                Excel uploads
            </small>

        </div>

    </div>


</div>



<!-- =========================
     WORK DETAILS
     ========================= -->

<div id="work-orders"
     class="dashboard-card work-details-card">

    <div class="section-header">

        <div class="section-title">

            <div class="section-icon blue">
                ▣
            </div>

            <div>
                <h2>Work Details</h2>
                <p>WORK_ORDER</p>
            </div>

        </div>

        <button class="primary-button"
                type="button">

            View All

        </button>

    </div>


    <div class="work-table-wrapper">

        <table class="work-table">

            <thead>
                <tr>
                    <th class="col-number">#</th>

                    <th class="col-work-code">
                        Work Code
                    </th>

                    <th class="col-work-name">
                        Work Details
                    </th>

                    <th class="col-user">
                        User
                    </th>

                    <th class="col-status">
                        Status
                    </th>
                </tr>
            </thead>

            <tbody id="workOrderTableBody">

                <tr>

                    <td colspan="7"
                        class="empty-row">

                        Loading work orders...

                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</div>





<!-- =========================
     STATIONS
     ========================= -->

<div id="stations"
     class="dashboard-card table-card">

    <div class="section-header">

        <div class="section-title">

            <div class="section-icon green">
                ▦
            </div>

            <div>

                <h2>Station Details</h2>

                <p>
                    STATION_DETAILS
                </p>

            </div>

        </div>


        <button class="primary-button">
            View All
        </button>

    </div>


    <div class="table-container">

        <table>

            <thead>

                <tr>

                    <th>#</th>
                    <th>Station Code</th>
                    <th>Substation Name</th>
                    <th>Zone</th>
                    <th>Circle</th>
                    <th>Division</th>
                    <th>Voltage Class</th>
                    <th>Type</th>
                    <th>Work Code</th>

                </tr>

            </thead>


            <tbody id="stationTableBody">

                <tr>
                    <td colspan="9" class="empty-row">
                        Loading station details...
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>



<!-- =========================
     LINES
     ========================= -->

<div id="lines"
     class="dashboard-card table-card">

    <div class="section-header">

        <div class="section-title">

            <div class="section-icon orange">
                ◇
            </div>

            <div>

                <h2>Line Code Details</h2>

                <p>
                    LINE_CODE_DETAILS
                </p>

            </div>

        </div>


        <button class="primary-button">
            View All
        </button>

    </div>


    <div class="table-container">

        <table>

            <thead>

                <tr>

                    <th>#</th>
                    <th>Line Code</th>
                    <th>Line Name</th>
                    <th>Zone</th>
                    <th>Circle</th>
                    <th>Division</th>
                    <th>Voltage Class</th>
                    <th>Line Type</th>
                    <th>Zone Code</th>
                    <th>Work Code</th>

                </tr>

            </thead>


            <tbody id="lineTableBody">

                <tr>
                    <td colspan="10" class="empty-row">
                        Loading line details...
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>



<!-- =========================
     UPLOAD
     ========================= -->

<div id="upload"
     class="dashboard-card upload-card">

    <div class="section-header">

        <div class="section-title">

            <div class="section-icon purple">
                ↑
            </div>

            <div>

                <h2>Upload Excel</h2>

                <p>
                    Import project survey data
                </p>

            </div>

        </div>

    </div>


    <div class="upload-area">

        <div class="upload-large-icon">
            ↑
        </div>

        <h3>
            Upload Excel File
        </h3>

        <p>
            Drag and drop your Excel file here
            or select a file from your computer
        </p>

        <input type="file"
               id="excelFile"
               accept=".xlsx,.xls"
               hidden />

        <button class="primary-button upload-button"
                type="button"
                onclick="document.getElementById('excelFile').click()">

            Browse File

        </button>

        <div id="selectedFile"
             class="selected-file">
        </div>

    </div>

</div>



@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            loadWorkOrders();
            loadStations();
            loadLines();

        });


        // =====================================================
        // GET VALUE
        // Handles different JSON property name formats
        // =====================================================

        function getValue(item, propertyName) {

            if (!item) {
                return "";
            }

            // Exact property
            if (item[propertyName] !== undefined &&
                item[propertyName] !== null) {

                return item[propertyName];
            }

            // Case-insensitive search
            const key = Object.keys(item).find(
                x => x.toLowerCase() === propertyName.toLowerCase()
            );

            if (key) {
                return item[key] ?? "";
            }

            return "";
        }


        // =====================================================
        // GET DATA FROM API RESPONSE
        // Supports:
        // { data: [...] }
        // OR
        // [...]
        // =====================================================

        function getApiData(result) {

            if (Array.isArray(result)) {
                return result;
            }

            if (result &&
                Array.isArray(result.data)) {

                return result.data;
            }

            if (result &&
                Array.isArray(result.Data)) {

                return result.Data;
            }

            return [];
        }


        // =====================================================
        // WORK ORDERS
        // =====================================================

        async function loadWorkOrders() {

            const tbody =
                document.getElementById("workOrderTableBody");

            const countElement =
                document.getElementById("workOrderCount");


            try {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="empty-row">
                            Loading work orders...
                        </td>
                    </tr>
                `;


                const response =
                    await fetch("/api/WorkOrder", {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });


                if (!response.ok) {

                    const errorText =
                        await response.text();

                    console.error(
                        "Work Order API Error:",
                        response.status,
                        errorText
                    );

                    throw new Error(
                        "API returned " +
                        response.status
                    );
                }


                const result =
                    await response.json();

                console.log(
                    "WORK ORDER API RESPONSE:",
                    result
                );


                const data =
                    getApiData(result);


                countElement.innerText =
                    data.length;


                tbody.innerHTML = "";


                if (data.length === 0) {

                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" class="empty-row">
                                No work order records found
                            </td>
                        </tr>
                    `;

                    return;
                }


                data.forEach(function (item, index) {

                    const workCode =
                        getValue(item, "WORK_CODE");

                    const nameOfWork =
                        getValue(item, "NAME_OF_WORK");

                    const subWorkCode =
                        getValue(item, "SUB_WORKCODE");

                    const nameOfSubWork =
                        getValue(item, "NAME_OF_SUBWORK");

                    const userName =
                        getValue(item, "USER_NAME");

                    const status =
                        getValue(item, "STATUS");


                                                   tbody.innerHTML += `

            <tr class="work-parent-row">

                <td>
                    ${index + 1}
                </td>

                <td>
                    <span class="record-code">
                        ${workCode}
                    </span>
                </td>

                <td>

                    <div class="work-parent">

                        <div class="work-parent-title">
                            ${nameOfWork}
                        </div>

                        <div class="sub-work">

                            <div class="sub-work-line">
                                <span class="sub-work-branch">└─</span>

                                <div class="sub-work-content">

                                    <span class="sub-work-label">
                                        Sub Work
                                    </span>

                                    <span class="sub-work-code">
                                        ${subWorkCode}
                                    </span>

                                    <div class="sub-work-name">
                                        ${nameOfSubWork}
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </td>

                <td>
                    ${userName}
                </td>

                <td>

                    <span class="status-badge">
                        ${status == 1 ? "Active" : "Inactive"}
                    </span>

                </td>

            </tr>

        `;

                });

            }
            catch (error) {

                console.error(
                    "Work Order Error:",
                    error
                );


                countElement.innerText = "0";


                tbody.innerHTML = `

                    <tr>

                        <td colspan="7"
                            class="empty-row">

                            Unable to load work orders

                        </td>

                    </tr>

                `;

            }

        }


        // =====================================================
        // STATION DETAILS
        // =====================================================

        async function loadStations() {

            const tbody =
                document.getElementById("stationTableBody");

            const countElement =
                document.getElementById("stationCount");


            try {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="empty-row">
                            Loading station details...
                        </td>
                    </tr>
                `;


                const response =
                    await fetch("/api/StationDetails", {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });


                if (!response.ok) {

                    const errorText =
                        await response.text();

                    console.error(
                        "Station API Error:",
                        response.status,
                        errorText
                    );

                    throw new Error(
                        "API returned " +
                        response.status
                    );
                }


                const result =
                    await response.json();


                console.log(
                    "STATION API RESPONSE:",
                    result
                );


                const data =
                    getApiData(result);


                countElement.innerText =
                    data.length;


                tbody.innerHTML = "";


                if (data.length === 0) {

                    tbody.innerHTML = `
                        <tr>
                            <td colspan="9" class="empty-row">
                                No station records found
                            </td>
                        </tr>
                    `;

                    return;
                }


                data.forEach(function (item, index) {

                    const stationCode =
                        getValue(item, "STATION_CODE");

                    const substationName =
                        getValue(item, "SUBSTATION_NAME");

                    const zone =
                        getValue(item, "ZONE");

                    const circle =
                        getValue(item, "CIRCLE");

                    const division =
                        getValue(item, "DIVISION");

                    const voltageClass =
                        getValue(item, "VOLTAGE_CLASS");

                    const type =
                        getValue(item, "TYPE_OF_SUBSTATION");

                    const workCode =
                        getValue(item, "WORK_CODE");


                    tbody.innerHTML += `

                        <tr>

                            <td>
                                ${index + 1}
                            </td>

                                   <td>
            <span class="record-code">
                ${stationCode}
            </span>
        </td>

                            <td>
                                ${substationName}
                            </td>

                            <td>
                                ${zone}
                            </td>

                            <td>
                                ${circle}
                            </td>

                            <td>
                                ${division}
                            </td>

                            <td>
                                ${voltageClass}
                            </td>

                            <td>
                                ${type}
                            </td>

                            <td>
                                ${workCode}
                            </td>

                        </tr>

                    `;

                });

            }
            catch (error) {

                console.error(
                    "Station Error:",
                    error
                );


                countElement.innerText = "0";


                tbody.innerHTML = `

                    <tr>

                        <td colspan="9"
                            class="empty-row">

                            Unable to load station details

                        </td>

                    </tr>

                `;

            }

        }


        // =====================================================
        // LINE CODE DETAILS
        // =====================================================

        async function loadLines() {

            const tbody =
                document.getElementById("lineTableBody");

            const countElement =
                document.getElementById("lineCount");


            try {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="10" class="empty-row">
                            Loading line details...
                        </td>
                    </tr>
                `;


                const response =
                    await fetch("/api/LineCodeDetails", {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });


                if (!response.ok) {

                    const errorText =
                        await response.text();

                    console.error(
                        "Line API Error:",
                        response.status,
                        errorText
                    );

                    throw new Error(
                        "API returned " +
                        response.status
                    );
                }


                const result =
                    await response.json();


                console.log(
                    "LINE API RESPONSE:",
                    result
                );


                const data =
                    getApiData(result);


                countElement.innerText =
                    data.length;


                tbody.innerHTML = "";


                if (data.length === 0) {

                    tbody.innerHTML = `
                        <tr>
                            <td colspan="10" class="empty-row">
                                No line records found
                            </td>
                        </tr>
                    `;

                    return;
                }


                data.forEach(function (item, index) {

                    const lineCode =
                        getValue(item, "LINE_CODE");

                    const lineName =
                        getValue(item, "LINE_NAME");

                    const zone =
                        getValue(item, "ZONE");

                    const circle =
                        getValue(item, "CIRCLE");

                    const division =
                        getValue(item, "DIVISION");

                    const voltageClass =
                        getValue(item, "VOLTAGECLASS");

                    const lineType =
                        getValue(item, "LINE_TYPE");

                    const zoneCode =
                        getValue(item, "ZONE_CODE");

                    const workCode =
                        getValue(item, "WORK_CODE");


                    tbody.innerHTML += `

                        <tr>

                            <td>
                                ${index + 1}
                            </td>

                                   <td>
            <span class="record-code">
                ${lineCode}
            </span>
        </td>

                            <td>
                                ${lineName}
                            </td>

                            <td>
                                ${zone}
                            </td>

                            <td>
                                ${circle}
                            </td>

                            <td>
                                ${division}
                            </td>

                            <td>
                                ${voltageClass}
                            </td>

                            <td>
                                ${lineType}
                            </td>

                            <td>
                                ${zoneCode}
                            </td>

                            <td>
                                ${workCode}
                            </td>

                        </tr>

                    `;

                });

            }
            catch (error) {

                console.error(
                    "Line Error:",
                    error
                );


                countElement.innerText = "0";


                tbody.innerHTML = `

                    <tr>

                        <td colspan="10"
                            class="empty-row">

                            Unable to load line details

                        </td>

                    </tr>

                `;

            }

        }

    </script>

}