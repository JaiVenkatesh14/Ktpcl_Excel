@{
    ViewData["Title"] = "Dashboard";
}


<!-- =========================
     PAGE HEADER
     ========================= -->

<div class="page-heading">

    <div>

        <h1>Dashboard</h1>

        @* <p>
            Welcome back, Admin
        </p> *@

    </div>

    <div class="system-status">

        <span class="status-dot"></span>

        System Online

    </div>

</div>







<!-- =========================
     STATISTICS
     ========================= -->

<div class="stats-grid">


    <div class="stat-card">

        <div class="stat-icon blue">
            ▣
        </div>

        <div class="stat-content">

            <span>Total Work Orders</span>

            <strong id="workOrderCount">0</strong>

            <small>
                WORK_ORDER
            </small>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon green">
            ▦
        </div>

        <div class="stat-content">

            <span>Total Stations</span>

            <strong id="stationCount">0</strong>

            <small>
                STATION_DETAILS
            </small>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon orange">
            ◇
        </div>

        <div class="stat-content">

            <span>Total Lines</span>

            <strong id="lineCount">0</strong>

            <small>
                LINE_CODE_DETAILS
            </small>

        </div>

    </div>


    <div class="stat-card">

        <div class="stat-icon purple">
            ↑
        </div>

        <div class="stat-content">

            <span>Total Imports</span>

            <strong>0</strong>

            <small>
                Excel uploads
            </small>

        </div>

    </div>


</div>



<!-- =========================
     WORK DETAILS
     ========================= -->

<div id="work-orders"
     class="dashboard-card work-details-card">

    <div class="section-header">

        <div class="section-title">

            <div class="section-icon blue">
                ▣
            </div>

            <div>
                <h2>Work Details</h2>
                <p>WORK_ORDER</p>
            </div>

        </div>

        <button class="primary-button"
                type="button">

            View All

        </button>

    </div>


    <div class="work-table-wrapper">

        <table class="work-table">

            <thead>
                <tr>

                    <th class="col-number">#</th>

                    <th class="col-work-code">
                        Work Code
                    </th>

                    <th class="col-work-name">
                        Work Details
                    </th>

                    <th class="col-user">
                        User
                    </th>

                </tr>
            </thead>

            <tbody id="workOrderTableBody">

                <tr>
                    <td colspan="4" class="empty-row">
                        Loading work orders...
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>





<!-- =========================
     STATIONS
     ========================= -->

<div id="stations"
     class="dashboard-card table-card">

    <div class="section-header">

        <div class="section-title">

            <div class="section-icon green">
                ▦
            </div>

            <div>

                <h2>Station Details</h2>

                <p>
                    STATION_DETAILS
                </p>

            </div>

        </div>


        <button class="primary-button">
            View All
        </button>

    </div>


    <div class="station-table-container">

        <table>

            <thead>

                <tr>

                    <th>#</th>
                    <th>Station Code</th>
                    <th>Substation Name</th>
                    <th>Zone</th>
                    <th>Circle</th>
                    <th>Division</th>
                    <th>Voltage Class</th>
                    <th>Type</th>
                    <th>Work Code</th>

                </tr>

            </thead>


            <tbody id="stationTableBody">

                <tr>
                    <td colspan="9" class="empty-row">
                        Loading station details...
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>



<!-- =========================
     LINES
     ========================= -->

<div id="lines"
     class="dashboard-card table-card">

    <div class="section-header">

        <div class="section-title">

            <div class="section-icon orange">
                ◇
            </div>

            <div>

                <h2>Line Code Details</h2>

                <p>
                    LINE_CODE_DETAILS
                </p>

            </div>

        </div>


        <button class="primary-button">
            View All
        </button>

    </div>


    <div class="table-container">

        <table>

            <thead>

                <tr>

                    <th>#</th>
                    <th>Line Code</th>
                    <th>Line Name</th>
                    <th>Zone</th>
                    <th>Circle</th>
                    <th>Division</th>
                    <th>Voltage Class</th>
                    <th>Line Type</th>
                    <th>Zone Code</th>
                    <th>Work Code</th>

                </tr>

            </thead>


            <tbody id="lineTableBody">

                <tr>
                    <td colspan="10" class="empty-row">
                        Loading line details...
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</div>



<!-- =========================
     UPLOAD EXCEL
     ========================= -->

<div id="upload"
     class="dashboard-card upload-card">

    <div class="section-header">

        <div class="section-title">

            <div class="section-icon purple">
                ↑
            </div>

            <div>

                <h2>Upload Excel</h2>

                <p>
                    Import project survey data into Oracle
                </p>

            </div>

        </div>

    </div>


    <div class="upload-area"
         id="uploadArea">

        <div class="upload-large-icon">
            ↑
        </div>


        <h3>
            Upload Excel File
        </h3>


        <p>
            Select the Excel file containing
            Work Orders, Stations and Line Codes
        </p>


        <input type="file"
               id="excelFile"
               accept=".xlsx"
               hidden />


        <button class="primary-button upload-button"
                type="button"
                id="browseFileButton">

            Browse File

        </button>


        <div id="selectedFile"
             class="selected-file">
        </div>


        <button class="upload-submit-button"
                type="button"
                id="uploadExcelButton"
                disabled>

            Upload to Database

        </button>


        <div id="uploadStatus"
             class="upload-status">
        </div>

    </div>

</div>



@section Scripts {

    <script>
        const appBasePath = '@Url.Content("~/")';

        document.addEventListener("DOMContentLoaded", function () {

            loadWorkOrders();
            loadStations();
            loadLines();

        });


        // =====================================================
        // GET VALUE
        // Handles different JSON property name formats
        // =====================================================

        function getValue(item, propertyName) {

            if (!item) {
                return "";
            }

            // Exact property
            if (item[propertyName] !== undefined &&
                item[propertyName] !== null) {

                return item[propertyName];
            }

            // Case-insensitive search
            const key = Object.keys(item).find(
                x => x.toLowerCase() === propertyName.toLowerCase()
            );

            if (key) {
                return item[key] ?? "";
            }

            return "";
        }


        // =====================================================
        // GET DATA FROM API RESPONSE
        // Supports:
        // { data: [...] }
        // OR
        // [...]
        // =====================================================

        function getApiData(result) {

            if (Array.isArray(result)) {
                return result;
            }

            if (result &&
                Array.isArray(result.data)) {

                return result.data;
            }

            if (result &&
                Array.isArray(result.Data)) {

                return result.Data;
            }

            return [];
        }


        // =====================================================
        // WORK ORDERS
        // =====================================================
        // =====================================================
        // WORK ORDERS
        // PARENT WORK + CHILD SUB WORKS
        // =====================================================

        async function loadWorkOrders() {

            const tbody =
                document.getElementById("workOrderTableBody");

            const countElement =
                document.getElementById("workOrderCount");


            try {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="empty-row">
                            Loading work orders...
                        </td>
                    </tr>
                `;


                // =================================================
                // API
                // =================================================

                const response =
                    await fetch(appBasePath + "api/WorkOrder", {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });


                if (!response.ok) {

                    const errorText =
                        await response.text();

                    console.error(
                        "Work Order API Error:",
                        response.status,
                        errorText
                    );

                    throw new Error(
                        "API returned " + response.status
                    );
                }


                const result =
                    await response.json();


                console.log(
                    "WORK ORDER API RESPONSE:",
                    result
                );


                const data =
                    getApiData(result);


                // =================================================
                // GROUP BY WORK CODE
                // =================================================

                const groupedWorks = new Map();


                data.forEach(function (item) {

                    const workCode =
                        getValue(item, "WORK_CODE").trim();


                    const nameOfWork =
                        getValue(item, "NAME_OF_WORK");


                    const subWorkCode =
                        getValue(item, "SUB_WORKCODE");


                    const nameOfSubWork =
                        getValue(item, "NAME_OF_SUBWORK");


                    const userName =
                        getValue(item, "USER_NAME");


                    if (!workCode) {
                        return;
                    }


                    // ---------------------------------------------
                    // Create parent work
                    // ---------------------------------------------

                    if (!groupedWorks.has(workCode)) {

                        groupedWorks.set(
                            workCode,
                            {
                                workCode: workCode,

                                nameOfWork: nameOfWork,

                                subWorks: []
                            }
                        );

                    }


                    const parent =
                        groupedWorks.get(workCode);


                    // ---------------------------------------------
                    // Add child sub work
                    // ---------------------------------------------

                    const existingSubWork = parent.subWorks.find(
    x => x.subWorkCode === subWorkCode
);

if (existingSubWork) {

    if (userName) {

        const existingUsers = existingSubWork.userName
            ? existingSubWork.userName
                .split(",")
                .map(x => x.trim())
                .filter(Boolean)
            : [];

        const newUsers = userName
            .split(",")
            .map(x => x.trim())
            .filter(Boolean);

        newUsers.forEach(user => {

            if (!existingUsers.includes(user)) {
                existingUsers.push(user);
            }

        });

        existingSubWork.userName =
            existingUsers.join(", ");
    }

}
else {

    parent.subWorks.push({

        subWorkCode:
            subWorkCode,

        nameOfSubWork:
            nameOfSubWork,

        userName:
            userName || ""

    });

}

                });


                // =================================================
                // UNIQUE WORK ORDERS
                // =================================================

                const works =
                    Array.from(groupedWorks.values());


                countElement.innerText =
                    works.length;


                tbody.innerHTML = "";


                // =================================================
                // NO DATA
                // =================================================

                if (works.length === 0) {

                    tbody.innerHTML = `
                        <tr>
                            <td colspan="4" class="empty-row">
                                No work order records found
                            </td>
                        </tr>
                    `;

                    return;
                }


                // =================================================
                // RENDER PARENT WORKS
                // =================================================

                works.forEach(function (work, index) {


                    // ---------------------------------------------
                    // SUB WORK HTML
                    // ---------------------------------------------

                    let subWorkHtml = "";
                    let usersHtml = "";


                    work.subWorks.forEach(function(sub) {

                        // ---------------------------------------------
                        // SUB WORK
                        // ---------------------------------------------

                        subWorkHtml += `

                <div class="sub-work-item">

                    <div class="sub-work-branch">
                        └─
                    </div>

                    <div class="sub-work-content">

                        <div class="sub-work-heading">

                            <span class="sub-work-label">
                                SUB WORK
                            </span>

                            <span class="sub-work-code">
                                ${escapeHtml(
                            sub.subWorkCode || ""
                        )}
                            </span>

                        </div>

                        <div class="sub-work-name">

                            ${escapeHtml(
                            sub.nameOfSubWork || ""
                        )}

                        </div>

                    </div>

                </div>

            `;


                        // ---------------------------------------------
                        // USER FOR THIS SUB WORK
                        // ---------------------------------------------

                        usersHtml += `

                <div class="work-user-item">

                    ${escapeHtml(
                            sub.userName || ""
                        )}

                </div>

            `;

                    });

                    // ---------------------------------------------
                    // PARENT ROW
                    // ---------------------------------------------

                    tbody.innerHTML += `

                        <tr class="work-parent-row">

                            <!-- NUMBER -->

                            <td class="work-number-cell">

                                ${index + 1}

                            </td>


                            <!-- WORK CODE -->

                            <td class="work-code-cell">

                                <span class="record-code">

                                    ${escapeHtml(
                                        work.workCode
                                    )}

                                </span>

                            </td>


                            <!-- WORK DETAILS -->

                            <td class="work-details-cell">

                                <div class="work-parent">

                                    <!-- PARENT WORK -->

                                    <div class="work-parent-title">

                                        ${escapeHtml(
                                            work.nameOfWork || ""
                                        )}

                                    </div>


                                    <!-- CHILDREN -->

                                    <div class="sub-work-list">

                                        ${subWorkHtml}

                                    </div>

                                </div>

                            </td>


                            <!-- USERS -->

                            <td class="work-user-cell">

                                <div class="work-users">

                                    ${usersHtml}

                                </div>

                            </td>

                        </tr>

                    `;

                });


            }
            catch (error) {

                console.error(
                    "Work Order Error:",
                    error
                );


                countElement.innerText =
                    "0";


                tbody.innerHTML = `

                    <tr>

                        <td colspan="4"
                            class="empty-row">

                            Unable to load work orders

                        </td>

                    </tr>

                `;

            }

        }


        // =====================================================
        // STATION DETAILS
        // =====================================================

        async function loadStations() {

            const tbody =
                document.getElementById("stationTableBody");

            const countElement =
                document.getElementById("stationCount");


            try {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="empty-row">
                            Loading station details...
                        </td>
                    </tr>
                `;


                const response =
                    await fetch(appBasePath + "api/StationDetails", {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });


                if (!response.ok) {

                    const errorText =
                        await response.text();

                    console.error(
                        "Station API Error:",
                        response.status,
                        errorText
                    );

                    throw new Error(
                        "API returned " +
                        response.status
                    );
                }


                const result =
                    await response.json();


                console.log(
                    "STATION API RESPONSE:",
                    result
                );


                const data =
                    getApiData(result);


                countElement.innerText =
                    data.length;


                tbody.innerHTML = "";


                if (data.length === 0) {

                    tbody.innerHTML = `
                        <tr>
                            <td colspan="9" class="empty-row">
                                No station records found
                            </td>
                        </tr>
                    `;

                    return;
                }


                data.forEach(function (item, index) {

                    const stationCode =
                        getValue(item, "STATION_CODE");

                    const substationName =
                        getValue(item, "SUBSTATION_NAME");

                    const zone =
                        getValue(item, "ZONE");

                    const circle =
                        getValue(item, "CIRCLE");

                    const division =
                        getValue(item, "DIVISION");

                    const voltageClass =
                        getValue(item, "VOLTAGE_CLASS");

                    const type =
                        getValue(item, "TYPE_OF_SUBSTATION");

                    const workCode =
                        getValue(item, "WORK_CODE");


                    tbody.innerHTML += `

                        <tr>

                            <td>
                                ${index + 1}
                            </td>

                                   <td>
            <span class="record-code">
                ${stationCode}
            </span>
        </td>

                            <td>
                                ${substationName}
                            </td>

                            <td>
                                ${zone}
                            </td>

                            <td>
                                ${circle}
                            </td>

                            <td>
                                ${division}
                            </td>

                            <td>
                                ${voltageClass}
                            </td>

                            <td>
                                ${type}
                            </td>

                            <td>
                                ${workCode}
                            </td>

                        </tr>

                    `;

                });

            }
            catch (error) {

                console.error(
                    "Station Error:",
                    error
                );


                countElement.innerText = "0";


                tbody.innerHTML = `

                    <tr>

                        <td colspan="9"
                            class="empty-row">

                            Unable to load station details

                        </td>

                    </tr>

                `;

            }

        }


        // =====================================================
        // LINE CODE DETAILS
        // =====================================================

        async function loadLines() {

            const tbody =
                document.getElementById("lineTableBody");

            const countElement =
                document.getElementById("lineCount");


            try {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="10" class="empty-row">
                            Loading line details...
                        </td>
                    </tr>
                `;


                const response =
                    await fetch(appBasePath + "api/LineCodeDetails", {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });


                if (!response.ok) {

                    const errorText =
                        await response.text();

                    console.error(
                        "Line API Error:",
                        response.status,
                        errorText
                    );

                    throw new Error(
                        "API returned " +
                        response.status
                    );
                }


                const result =
                    await response.json();


                console.log(
                    "LINE API RESPONSE:",
                    result
                );


                const data =
                    getApiData(result);


                countElement.innerText =
                    data.length;


                tbody.innerHTML = "";


                if (data.length === 0) {

                    tbody.innerHTML = `
                        <tr>
                            <td colspan="10" class="empty-row">
                                No line records found
                            </td>
                        </tr>
                    `;

                    return;
                }


                data.forEach(function (item, index) {

                    const lineCode =
                        getValue(item, "LINE_CODE");

                    const lineName =
                        getValue(item, "LINE_NAME");

                    const zone =
                        getValue(item, "ZONE");

                    const circle =
                        getValue(item, "CIRCLE");

                    const division =
                        getValue(item, "DIVISION");

                    const voltageClass =
                        getValue(item, "VOLTAGECLASS");

                    const lineType =
                        getValue(item, "LINE_TYPE");

                    const zoneCode =
                        getValue(item, "ZONE_CODE");

                    const workCode =
                        getValue(item, "WORK_CODE");


                    tbody.innerHTML += `

                        <tr>

                            <td>
                                ${index + 1}
                            </td>

                                   <td>
            <span class="record-code">
                ${lineCode}
            </span>
        </td>

                            <td>
                                ${lineName}
                            </td>

                            <td>
                                ${zone}
                            </td>

                            <td>
                                ${circle}
                            </td>

                            <td>
                                ${division}
                            </td>

                            <td>
                                ${voltageClass}
                            </td>

                            <td>
                                ${lineType}
                            </td>

                            <td>
                                ${zoneCode}
                            </td>

                            <td>
                                ${workCode}
                            </td>

                        </tr>

                    `;

                });

            }
            catch (error) {

                console.error(
                    "Line Error:",
                    error
                );


                countElement.innerText = "0";


                tbody.innerHTML = `

                    <tr>

                        <td colspan="10"
                            class="empty-row">

                            Unable to load line details

                        </td>

                    </tr>

                `;

            }

        }

                // =====================================================
        // EXCEL UPLOAD
        // =====================================================

        const excelFile =
            document.getElementById("excelFile");

        const browseFileButton =
            document.getElementById("browseFileButton");

        const uploadExcelButton =
            document.getElementById("uploadExcelButton");

        const selectedFile =
            document.getElementById("selectedFile");

        const uploadStatus =
            document.getElementById("uploadStatus");

        const uploadArea =
            document.getElementById("uploadArea");


        // =====================================================
        // BROWSE FILE
        // =====================================================

        browseFileButton.addEventListener(
            "click",
            function () {

                excelFile.click();

            }
        );


        // =====================================================
        // FILE SELECTED
        // =====================================================

        excelFile.addEventListener(
            "change",
            function () {

                clearUploadStatus();

                if (!excelFile.files ||
                    excelFile.files.length === 0) {

                    selectedFile.innerHTML = "";

                    uploadExcelButton.disabled = true;

                    return;
                }


                const file =
                    excelFile.files[0];


                // ---------------------------------------------
                // Check extension
                // ---------------------------------------------

                const fileName =
                    file.name.toLowerCase();


                if (!fileName.endsWith(".xlsx")) {

                    showUploadError(
                        "Only .xlsx Excel files are allowed."
                    );

                    excelFile.value = "";

                    uploadExcelButton.disabled = true;

                    return;
                }


                // ---------------------------------------------
                // Check file size
                // ---------------------------------------------

                const maxSize =
                    10 * 1024 * 1024;


                if (file.size > maxSize) {

                    showUploadError(
                        "File size cannot exceed 10 MB."
                    );

                    excelFile.value = "";

                    uploadExcelButton.disabled = true;

                    return;
                }


                // ---------------------------------------------
                // Show selected file
                // ---------------------------------------------

                selectedFile.innerHTML = `

                    <div class="selected-file-box">

                        <span class="selected-file-icon">
                            XLSX
                        </span>

                        <div class="selected-file-info">

                            <strong>
                                ${escapeHtml(file.name)}
                            </strong>

                            <small>
                                ${formatFileSize(file.size)}
                            </small>

                        </div>

                    </div>

                `;


                uploadExcelButton.disabled = false;

            }
        );


        // =====================================================
        // UPLOAD
        // =====================================================

        uploadExcelButton.addEventListener(
            "click",
            async function () {

                if (!excelFile.files ||
                    excelFile.files.length === 0) {

                    showUploadError(
                        "Please select an Excel file first."
                    );

                    return;
                }


                const file =
                    excelFile.files[0];


                // Disable controls

                uploadExcelButton.disabled = true;

                browseFileButton.disabled = true;


                uploadExcelButton.innerText =
                    "Uploading...";


                showUploadInfo(
                    "Validating Excel file and importing data. Please wait..."
                );


                try {

                    const formData =
                        new FormData();


                    formData.append(
                        "file",
                        file
                    );


                    // =========================================
                    // CALL EXCEL IMPORT API
                    // =========================================

                    const response =
                        await fetch(
                            appBasePath + "api/ExcelImport/validate",
                            {
                                method: "POST",
                                body: formData
                            }
                        );


                   const responseText =
    await response.text();

console.log(
    "EXCEL IMPORT HTTP STATUS:",
    response.status
);

console.log(
    "EXCEL IMPORT RAW RESPONSE:",
    responseText
);


let result = null;

try {

    result = responseText
        ? JSON.parse(responseText)
        : null;

}
catch (jsonError) {

    console.error(
        "Excel Import JSON Error:",
        jsonError
    );

    throw new Error(
        "Server returned an invalid response."
    );
}


console.log(
    "EXCEL IMPORT RESPONSE:",
    result
);


if (!response.ok ||
    !result ||
    result.success === false) {

    let message =
        result?.message ||
        `Excel import failed. Server returned HTTP ${response.status}.`;


    if (result?.errors &&
        result.errors.length > 0) {

        message += "<br><br>";

        message +=
            "<strong>Errors:</strong><br>";


        result.errors.forEach(
            function (error) {

                message +=
                    `• ${escapeHtml(error.message)}<br>`;

            }
        );
    }


    showUploadError(message);

    return;
}


                    // =========================================
                    // API ERROR
                    // =========================================

                    if (!response.ok ||
                        result.success === false) {

                        let message =
                            result.message ||
                            "Excel import failed.";


                        // Show detailed errors

                        if (result.errors &&
                            result.errors.length > 0) {

                            message += "<br><br>";

                            message +=
                                "<strong>Errors:</strong><br>";


                            result.errors.forEach(
                                function (error) {

                                    message +=
                                        `• ${escapeHtml(error.message)}<br>`;

                                }
                            );
                        }


                        showUploadError(message);

                        return;
                    }


                    // =========================================
                    // SUCCESS
                    // =========================================

                    showUploadSuccess(
                        result.message ||
                        "Excel data imported successfully."
                    );


                    // Clear selected file

                    excelFile.value = "";

                    selectedFile.innerHTML = "";


                    // =========================================
                    // REFRESH DASHBOARD DATA
                    // =========================================

                    await Promise.all([
                        loadWorkOrders(),
                        loadStations(),
                        loadLines()
                    ]);


                }
                catch (error) {

                    console.error(
                        "Excel Upload Error:",
                        error
                    );


                    showUploadError(
                        "Unable to connect to the Excel import API."
                    );

                }
                finally {

                    uploadExcelButton.disabled = true;

                    browseFileButton.disabled = false;

                    uploadExcelButton.innerText =
                        "Upload to Database";

                }

            }
        );


        // =====================================================
        // DRAG AND DROP
        // =====================================================

        uploadArea.addEventListener(
            "dragover",
            function (event) {

                event.preventDefault();

                uploadArea.classList.add(
                    "drag-over"
                );

            }
        );


        uploadArea.addEventListener(
            "dragleave",
            function () {

                uploadArea.classList.remove(
                    "drag-over"
                );

            }
        );


        uploadArea.addEventListener(
            "drop",
            function (event) {

                event.preventDefault();

                uploadArea.classList.remove(
                    "drag-over"
                );


                const files =
                    event.dataTransfer.files;


                if (!files ||
                    files.length === 0) {

                    return;
                }


                excelFile.files = files;


                excelFile.dispatchEvent(
                    new Event("change")
                );

            }
        );


        // =====================================================
        // STATUS FUNCTIONS
        // =====================================================

        function showUploadSuccess(message) {

            uploadStatus.innerHTML = `

                <div class="upload-message success">

                    <span class="message-icon">
                        ✓
                    </span>

                    <span>
                        ${message}
                    </span>

                </div>

            `;

        }


        function showUploadError(message) {

            uploadStatus.innerHTML = `

                <div class="upload-message error">

                    <span class="message-icon">
                        !
                    </span>

                    <span>
                        ${message}
                    </span>

                </div>

            `;

        }


        function showUploadInfo(message) {

            uploadStatus.innerHTML = `

                <div class="upload-message info">

                    <span class="message-icon">
                        ...
                    </span>

                    <span>
                        ${message}
                    </span>

                </div>

            `;

        }


        function clearUploadStatus() {

            uploadStatus.innerHTML = "";

        }


        // =====================================================
        // FILE SIZE
        // =====================================================

        function formatFileSize(bytes) {

            if (bytes < 1024)
                return bytes + " B";

            if (bytes < 1024 * 1024)
                return (bytes / 1024).toFixed(1) + " KB";

            return (bytes / (1024 * 1024)).toFixed(2) + " MB";

        }


        // =====================================================
        // HTML ESCAPE
        // =====================================================

        function escapeHtml(value) {

            if (value === null ||
                value === undefined) {

                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

        }

    </script>

}