@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard">

    <!-- Header -->

    <div class="dashboard-header">

        <div>

            <h1>KPTCL Dashboard</h1>

            <p>
                Survey Data Management System
            </p>

        </div>

        <div class="system-status">

            <span class="status-dot"></span>

            System Online

        </div>

    </div>


    <!-- Statistics -->

    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon work">
                ▣
            </div>

            <div>

                <span>Work Orders</span>

                <strong>0</strong>

                <small>Total work orders</small>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon station">
                ▦
            </div>

            <div>

                <span>Stations</span>

                <strong>0</strong>

                <small>Total substations</small>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon line">
                ◇
            </div>

            <div>

                <span>Lines</span>

                <strong>0</strong>

                <small>Total line codes</small>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon import">
                ↑
            </div>

            <div>

                <span>Imports</span>

                <strong>0</strong>

                <small>Successful imports</small>

            </div>

        </div>

    </div>


    <!-- Main Area -->

    <div class="content-grid">


        <!-- Excel Upload -->

        <div class="dashboard-card">

            <div class="card-header">

                <div>

                    <h2>Excel Data Import</h2>

                    <p>
                        Upload project survey data
                    </p>

                </div>

                <div class="card-symbol">
                    ↑
                </div>

            </div>


            <div class="upload-area">

                <div class="upload-symbol">
                    ↑
                </div>

                <h3>
                    Upload Excel File
                </h3>

                <p>
                    Select the Excel file containing
                    project survey data.
                </p>


                <input type="file"
                       id="excelFile"
                       accept=".xlsx,.xls"
                       hidden />


                <button type="button"
                        class="select-button"
                        onclick="document.getElementById('excelFile').click()">

                    Choose Excel File

                </button>


                <div id="fileName"
                     class="file-name">
                </div>

            </div>

        </div>


        <!-- Database Tables -->

        <div class="dashboard-card">

            <div class="card-header">

                <div>

                    <h2>Database Tables</h2>

                    <p>
                        Oracle tables
                    </p>

                </div>

                <div class="card-symbol">
                    ▥
                </div>

            </div>


            <div class="table-list">


                <div class="table-item">

                    <div class="table-symbol">
                        ▣
                    </div>

                    <div>

                        <strong>
                            Work Orders
                        </strong>

                        <small>
                            WORK_ORDER
                        </small>

                    </div>

                    <span>
                        0
                    </span>

                </div>


                <div class="table-item">

                    <div class="table-symbol">
                        ▦
                    </div>

                    <div>

                        <strong>
                            Stations
                        </strong>

                        <small>
                            STATION_DETAILS
                        </small>

                    </div>

                    <span>
                        0
                    </span>

                </div>


                <div class="table-item">

                    <div class="table-symbol">
                        ◇
                    </div>

                    <div>

                        <strong>
                            Lines
                        </strong>

                        <small>
                            LINE_CODE_DETAILS
                        </small>

                    </div>

                    <span>
                        0
                    </span>

                </div>


            </div>

        </div>

    </div>

</div>


<style>

    .dashboard {
        max-width: 1400px;
        margin: auto;
        padding: 35px 25px;
    }


    /* HEADER */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .dashboard-header h1 {
        margin: 0;
        font-size: 32px;
        color: #123b63;
    }

    .dashboard-header p {
        margin-top: 7px;
        color: #6b7280;
    }


    .system-status {
        display: flex;
        align-items: center;
        gap: 8px;

        padding: 10px 16px;

        background: #ecfdf5;

        border: 1px solid #bbf7d0;

        border-radius: 20px;

        color: #15803d;

        font-size: 14px;
        font-weight: 600;
    }

    .status-dot {
        width: 9px;
        height: 9px;

        background: #16a34a;

        border-radius: 50%;
    }


    /* STATISTICS */

    .stats-grid {
        display: grid;
        grid-template-columns:
            repeat(4, 1fr);

        gap: 20px;

        margin-bottom: 25px;
    }

    .stat-card {
        background: white;

        border: 1px solid #e5e7eb;

        border-radius: 12px;

        padding: 22px;

        display: flex;

        align-items: center;

        gap: 16px;

        box-shadow:
            0 2px 8px rgba(0,0,0,0.04);
    }

    .stat-icon {
        width: 55px;
        height: 55px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 12px;

        font-size: 25px;
        font-weight: bold;
    }

    .stat-icon.work {
        background: #e8f1ff;
        color: #2563eb;
    }

    .stat-icon.station {
        background: #e8f8ef;
        color: #15803d;
    }

    .stat-icon.line {
        background: #fff4df;
        color: #d97706;
    }

    .stat-icon.import {
        background: #f2eaff;
        color: #7c3aed;
    }

    .stat-card span {
        display: block;

        color: #6b7280;

        font-size: 14px;
    }

    .stat-card strong {
        display: block;

        font-size: 28px;

        margin-top: 3px;
    }

    .stat-card small {
        color: #9ca3af;
    }


    /* CONTENT */

    .content-grid {
        display: grid;

        grid-template-columns:
            1.5fr 1fr;

        gap: 25px;
    }

    .dashboard-card {
        background: white;

        border: 1px solid #e5e7eb;

        border-radius: 12px;

        padding: 25px;

        box-shadow:
            0 2px 8px rgba(0,0,0,0.04);
    }


    /* CARD HEADER */

    .card-header {
        display: flex;

        justify-content: space-between;

        align-items: center;

        margin-bottom: 22px;
    }

    .card-header h2 {
        margin: 0;

        font-size: 20px;

        color: #123b63;
    }

    .card-header p {
        margin: 5px 0 0;

        color: #6b7280;

        font-size: 14px;
    }

    .card-symbol {
        width: 45px;
        height: 45px;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #eef4ff;

        color: #2563eb;

        border-radius: 10px;

        font-size: 22px;

        font-weight: bold;
    }


    /* UPLOAD */

    .upload-area {
        border: 2px dashed #cbd5e1;

        border-radius: 12px;

        padding: 45px 20px;

        text-align: center;

        background: #f8fafc;
    }

    .upload-symbol {
        width: 65px;
        height: 65px;

        margin: auto;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #eaf1ff;

        color: #2563eb;

        border-radius: 50%;

        font-size: 30px;

        font-weight: bold;
    }

    .upload-area h3 {
        margin-top: 18px;

        font-size: 19px;
    }

    .upload-area p {
        color: #6b7280;

        font-size: 14px;
    }

    .select-button {
        margin-top: 10px;

        padding: 11px 20px;

        border: 1px solid #2563eb;

        background: white;

        color: #2563eb;

        border-radius: 7px;

        cursor: pointer;

        font-size: 14px;
    }

    .select-button:hover {
        background: #2563eb;

        color: white;
    }

    .file-name {
        margin-top: 15px;

        color: #374151;

        font-size: 14px;
    }


    /* DATABASE TABLES */

    .table-list {
        display: flex;

        flex-direction: column;

        gap: 12px;
    }

    .table-item {
        display: flex;

        align-items: center;

        gap: 12px;

        padding: 14px;

        border: 1px solid #e5e7eb;

        border-radius: 9px;
    }

    .table-symbol {
        width: 40px;
        height: 40px;

        display: flex;

        align-items: center;
        justify-content: center;

        background: #f1f5f9;

        border-radius: 8px;

        font-size: 19px;
    }

    .table-item div:nth-child(2) {
        flex: 1;
    }

    .table-item strong {
        display: block;

        color: #374151;
    }

    .table-item small {
        color: #9ca3af;
    }

    .table-item > span {
        font-weight: 700;
    }


    /* RESPONSIVE */

    @@media (max-width: 1000px) {

        .stats-grid {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .content-grid {
            grid-template-columns: 1fr;
        }

    }


    @@media (max-width: 600px) {

        .dashboard {
            padding: 20px 15px;
        }

        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

    }

</style>


@section Scripts {

    <script>

        document
            .getElementById("excelFile")
            .addEventListener("change", function () {

                const fileName =
                    document.getElementById("fileName");

                if (this.files.length > 0) {

                    fileName.textContent =
                        "Selected file: "
                        + this.files[0].name;

                }
                else {

                    fileName.textContent = "";

                }

            });

    </script>

}